# ---------------------------------------------------------------------------
# Production environment. See DEPLOY.md for the order to do things in.
#
# This is the deployment counterpart to `.env.example`: same variables, but the
# notes say what *breaks in production* rather than how to get started. Several
# things that are optional on a laptop are not optional on a server, and the
# differences are marked.
# ---------------------------------------------------------------------------

# --- Required. The app will not work without these. ------------------------

# Real Postgres, not PGlite.
#
# `pglite://` is an embedded database inside the Node process: one writer, and
# it vanishes with the container. Use the POOLED connection string on any
# serverless host (Neon's contains "-pooler"), because each invocation opens
# its own connection and an unpooled endpoint runs out.
#
# Without it: every API route returns 503.
DATABASE_URL=

# Signs session cookies.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Changing it later signs everybody out. Recoverable, unlike the key below.
# Without it: nobody can sign in.
AUTH_SECRET=

# Seals direct messages with AES-256-GCM before they reach Postgres.
#   node -e "console.log('1:' + require('crypto').randomBytes(32).toString('base64'))"
#
# *** Store this in a password manager before deploying. ***
#
# There is no reset. Lose it and every message ever sent is permanently
# unreadable -- the ciphertext is in the database and nothing can open it.
#
# Format is `version:base64`. Rotation is additive: append `,2:<newkey>` and
# restart. New messages seal under the highest version; existing rows keep
# decrypting under theirs, so nothing needs rewriting.
#
# In development this is optional -- a key is derived from AUTH_SECRET. In
# production its absence is fatal on purpose: the server refuses to start
# rather than quietly writing messages in plaintext.
MESSAGE_ENCRYPTION_KEY=

# The public origin. Scheme included, no trailing slash.
#
# Not optional in practice. It is the origin in the sitemap, in `og:url`, in
# `rel=canonical` and `hreflang`, and in every copied share link. Unset, all of
# them fall back to the request's own origin -- which is the proxy's hostname
# behind a load balancer, and `capacitor://localhost` in the mobile build,
# where a shared link reaches nothing.
#
# Set it to the host's generated URL first, then change it to the real domain
# and redeploy. Forgetting the second step leaves every share link pointing at
# the deploy URL.
NUXT_PUBLIC_APP_URL=https://your-domain.com

# --- Catalogue providers. The product is empty without these. --------------
#
# Needed at runtime for search and for resolving a result into a local row, and
# needed by `pnpm db:import` to populate the catalogue in the first place.

# https://www.themoviedb.org/settings/api  (films and television)
TMDB_API_KEY=

# https://rawg.io/apidocs  (games)
RAWG_API_KEY=

# https://api-docs.igdb.com  (games, richer metadata than RAWG)
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Books come from Open Library, which needs no key.

# --- Recommendations. Optional; the feature hides itself without them. -----
#
# The provider chain tries these in order and routes around one that is out of
# quota. With none set, the discovery panel is hidden rather than broken.

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# https://console.groq.com/keys
GROQ_API_KEY=

# Cerebras now requires billing; left here for completeness.
# CEREBRAS_API_KEY=

# --- Mail. Password reset silently fails without it. -----------------------
#
# With no key the mailer falls back to a console transport, which is right in
# development and wrong in production: a reset link gets logged instead of
# sent, so the reset appears to work and the email never arrives.
#
# https://resend.com/api-keys
MAIL_RESEND_API_KEY=
MAIL_FROM=noreply@your-domain.com

# --- Shared state. Optional on one instance, wanted on more. ---------------
#
# Backs the rate limiter and the read-through cache, both mounted in
# `nuxt.config.ts`. In-memory they are per-instance: rate limits get multiplied
# by the instance count, and the cache hit rate drops. Neither is incorrect,
# both are weaker. See DEPLOY.md for the two-line config change.
#
# https://upstash.com
REDIS_URL=

# --- Tuning. Leave these alone unless you have a reason. -------------------

NODE_ENV=production

# Logs every SQL statement. Useful once, expensive always.
# NUXT_LOG_QUERIES=false

# Candidates per media type sent to the recommendation model. Higher finds
# more niche titles and costs more tokens per request.
# DISCOVERY_CANDIDATES_PER_TYPE=60
