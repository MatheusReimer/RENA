# ---------------------------------------------------------------------------
# Copy this file to `.env` at the repository root and fill in the values.
# Never commit `.env` (SPEC 46).
# ---------------------------------------------------------------------------

# Postgres connection string.
#   Neon:  https://console.neon.tech -> create project -> copy the POOLED URL
#          (the host containing "-pooler"), which is what serverless needs.
#   Local: postgresql://postgres:postgres@localhost:5432/revy
DATABASE_URL=

# Signing secret for sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# The app's public URL. Leave blank for local development.
# Production example: https://revy.vercel.app
NUXT_PUBLIC_APP_URL=

# ---------------------------------------------------------------------------
# Media providers (SPEC 8). Provider credentials stay isolated.
# ---------------------------------------------------------------------------

# TMDB, for movies and series. Free key: https://www.themoviedb.org/settings/api
# Optional: without it the app still runs and book search works, but movie and
# series search returns nothing.
TMDB_API_KEY=

# Books use Open Library, which needs no key.

# ---------------------------------------------------------------------------
# Development
# ---------------------------------------------------------------------------

# Set to "true" to log every SQL statement.
NUXT_LOG_QUERIES=false
