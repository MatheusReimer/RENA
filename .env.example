# ---------------------------------------------------------------------------
# Copy this file to `.env` at the repository root and fill in the values.
# Never commit `.env` (SPEC 46).
# ---------------------------------------------------------------------------

# Postgres connection string.
#
#   Zero setup: pglite://.data/revy
#          Runs Postgres compiled to WebAssembly inside the Node process.
#          No install, no Docker, no account. `pnpm db:seed` creates and
#          migrates it for you. Development only -- single connection.
#
#   Neon:  https://console.neon.tech -> create project -> copy the POOLED URL
#          (the host containing "-pooler"), which is what serverless needs.
#
#   Local: postgresql://postgres:postgres@localhost:5432/revy
DATABASE_URL=pglite://.data/revy

# Signing secret for sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Message encryption keys (SPEC 12, 39).
#
# Direct message bodies are encrypted with AES-256-GCM before they are written
# to Postgres, so a leaked dump or backup contains no readable messages. This
# is encryption AT REST, not end-to-end: the server holds the key and can read
# messages, which is what keeps notifications and moderation possible. Do not
# describe the feature to users as end-to-end encrypted.
#
# Format is `version:base64key`, comma separated. The highest version encrypts
# new messages; every version listed can decrypt the rows written under it.
# Generate one with:
#   node -e "console.log('1:' + require('crypto').randomBytes(32).toString('base64'))"
#
# To rotate, append a new entry with a higher version and restart -- old
# messages keep working:
#   MESSAGE_ENCRYPTION_KEY=1:oldkey...,2:newkey...
#
# Optional in development: a key is derived from AUTH_SECRET so messaging works
# on a fresh clone, and the variable below is read from this file directly.
#
# In a DEPLOYED environment this name is not enough. Nuxt reads runtime config
# from `NUXT_`-prefixed variables, so the deployed process needs:
#
#   NUXT_MESSAGE_ENCRYPTION_KEY=1:...
#
# Set the wrong one and the server starts, logs "messaging is DISABLED", and
# serves everything except messages -- which is the safe failure, but a quiet
# one. Check the startup log after a deploy.
#
# Without a key in production, messaging is unavailable rather than degraded:
# there is no code path that writes a message body unencrypted. A *malformed*
# key stops the server from starting at all, because that is a mistake rather
# than a choice.
MESSAGE_ENCRYPTION_KEY=

# The app's public URL. Leave blank for local development.
# Production example: https://revy.vercel.app
# The public origin, with scheme and no trailing slash.
#
# Not optional in practice. It is the origin in the sitemap, in `og:url`, in
# `rel=canonical` and `hreflang` (via the i18n module), and in every copied
# profile link. Unset, each of those falls back to the request's own origin --
# which is right in development and wrong behind a proxy, and is
# `capacitor://localhost` in the mobile build, where a shared link reaches
# nothing.
NUXT_PUBLIC_APP_URL=http://localhost:3000

# Extra recommendation providers (SPEC 40). Both optional, both free.
#
# These do not replace GEMINI_API_KEY -- they stack behind it. The recommender
# tries each configured provider in order and falls through when one is busy,
# which is the failure that actually happens on a free tier: the model does not
# refuse, it just takes longer than anyone will wait.
#
# Order is Gemini, then Cerebras, then Groq, then Claude. Free before paid.
#
# Cerebras: https://cloud.cerebras.ai -- ~1M tokens/day, no card. The best fit
# behind Gemini for a prompt our size (~8k tokens per request).
CEREBRAS_API_KEY=
# Optional model override. Default: gpt-oss-120b
# Model names turn over fast here. List the current ones with:
#   curl https://api.cerebras.ai/v1/models -H "Authorization: Bearer $CEREBRAS_API_KEY"
CEREBRAS_MODEL=

# Groq: https://console.groq.com -- fast, but the tightest free tier of the
# three. On the larger models it allows ~12k tokens/minute and ~100k/day, so at
# our prompt size that is roughly one request a minute and a dozen a day. Worth
# having as a last link, not as a primary.
GROQ_API_KEY=
# Optional model override. Default: openai/gpt-oss-120b
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
GROQ_MODEL=

# ---------------------------------------------------------------------------
# Media providers (SPEC 8). Provider credentials stay isolated.
# ---------------------------------------------------------------------------

# TMDB, for movies and series: https://www.themoviedb.org/settings/api
#
# Either credential works -- the provider detects which one it was given:
#   - "API Key" (v3, 32 hex characters)
#   - "API Read Access Token" (v4, a long JWT starting with eyJ)
#
# Optional: without it the app still runs and book search works, but movie and
# series search returns nothing.
TMDB_API_KEY=

# ---------------------------------------------------------------------------
# Games. Three options, best catalogue first. All optional -- game search works
# with none of them, because Steam needs no credentials.
# ---------------------------------------------------------------------------

# IGDB: every platform back to the 1970s, including console and retro titles.
# This is the one to set if you want the whole history of games.
#
# It authenticates through Twitch:
#   1. https://dev.twitch.tv/console/apps -> Register Your Application
#   2. Name it anything, OAuth Redirect URL http://localhost, Category "Application Integration"
#   3. Copy the Client ID, then Manage -> New Secret for the secret
#
# The token exchange is handled for you; these two values are all that is needed.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# RAWG: broad and console-aware, one key. https://rawg.io/apidocs
# Used when IGDB is not configured.
RAWG_API_KEY=

# Without either, games fall back to Steam's storefront, which needs no key but
# is PC-only -- no Zelda, no Mario, no PlayStation exclusive.

# Books use Open Library, which needs no key.

# ---------------------------------------------------------------------------
# Development
# ---------------------------------------------------------------------------

# Set to "true" to log every SQL statement.
NUXT_LOG_QUERIES=false

# ---------------------------------------------------------------------------
# Email (password reset, address confirmation)
#
# Absent in development: the console transport prints the link to the terminal
# instead, so the whole reset flow works without a mail account.
#
# Absent in PRODUCTION, password reset fails loudly rather than falling back to
# the console -- a reset link is a bearer token, and printing one into a log
# aggregator hands the account to anyone who can read logs.
# ---------------------------------------------------------------------------
MAIL_RESEND_API_KEY=
# Envelope sender, e.g. "RENA <hello@yourdomain.com>". Required with the key.
MAIL_FROM=

# ---------------------------------------------------------------------------
# Described-request discovery (SPEC 40). Set ONE of the two keys below.
#
# Powers "Not sure what to watch next?" in the sidebar. Both are optional --
# with neither, the feature is not offered anywhere in the UI and the rest of
# the site is unaffected.
#
# Unlike the other credentials here, these are spent per request rather than
# per quota, which is why the endpoint is signed-in only and capped at 20
# questions per hour per person.
# ---------------------------------------------------------------------------

# Google Gemini: https://aistudio.google.com/apikey
#
# The free option, and the one used when both keys are set -- delete it to go
# back to Anthropic.
#
# Worth knowing before enabling it, because it is a product decision rather
# than a technical one: on Google's FREE tier, prompts and responses are used
# to improve their products. What this feature sends is a sentence somebody
# typed about what they feel like watching, which is more personal than it
# first sounds. Google's paid tier does not do this. Either choice is
# defensible; make it deliberately.
GEMINI_API_KEY=

# Pin a specific model instead of following Google's current Flash. Optional.
#   e.g. gemini-2.5-flash
GEMINI_MODEL=

# Anthropic: https://console.anthropic.com/settings/keys
#
# The paid alternative, used only when GEMINI_API_KEY is empty. Roughly 2-12
# cents per question depending on the model set in packages/core/src/ai.
# No training on your data, on any tier.
ANTHROPIC_API_KEY=
