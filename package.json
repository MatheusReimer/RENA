{
  "name": "revy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "dev": "pnpm --filter @revy/web dev",
    "build": "pnpm --filter @revy/web build",
    "preview": "pnpm --filter @revy/web preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "i18n:audit": "pnpm --filter @revy/web i18n:audit",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:smoke": "tsx tests/smoke/signup-flow.mts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @revy/db generate",
    "db:migrate": "pnpm --filter @revy/db migrate",
    "db:migrate:dev": "pnpm --filter @revy/seed migrate-dev",
    "db:push": "pnpm --filter @revy/db push",
    "db:seed": "pnpm --filter @revy/seed start",
    "db:badges": "pnpm --filter @revy/seed badges",
    "db:import": "pnpm --filter @revy/seed catalogue",
    "db:credits": "pnpm --filter @revy/seed credits",
    "db:scores": "pnpm --filter @revy/seed scores",
    "db:translate": "pnpm --filter @revy/seed translate",
    "db:verify": "pnpm --filter @revy/seed verify",
    "ai:compare": "pnpm --filter @revy/seed compare",
    "db:studio": "pnpm --filter @revy/db studio"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@revy/core": "workspace:*",
    "@revy/db": "workspace:*",
    "@revy/shared": "workspace:*",
    "@types/node": "^22.20.2",
    "drizzle-orm": "^0.45.2",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^9.33.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.2.12"
  },
  "dependencies": {
    "@neon/config": "^1.4.3",
    "@neon/env": "^1.3.3"
  }
}
