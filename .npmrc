shamefully-hoist=false
strict-peer-dependencies=false
auto-install-peers=true

# drizzle-orm declares optional peers on every driver it supports, so adding
# PGlite to one package made pnpm resolve a second, separate copy for it --
# and two copies means two incompatible sets of SQL<> types. Deduping keeps
# one instance across the workspace.
dedupe-peer-dependents=true
